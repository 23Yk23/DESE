rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bu kural, giriş yapmış (authenticated) herhangi bir kullanıcının
    // tüm veritabanını okumasına ve yazmasına izin verir.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
} // <-- EKSİK OLAN PARANTEZ BU